# Kopieer dit bestand eenmalig naar .env:
# cp .env.example .env
#
# Vul daarna hieronder je lokale instellingen in.

# PW_VIDEO heeft twee mogelijke waarden:
# 0 = geen video opnemen tijdens een test.
# 1 = per test een video.webm opnemen in test-results/.
PW_VIDEO=0

# Geen geheim, maar we hoeven het crawlers en botjes niet te gemakkelijk te maken
# Basis-URL van Open Forms, inclusief https:// en zonder afsluitende slash.
OPEN_FORMS_BASE_URL=
